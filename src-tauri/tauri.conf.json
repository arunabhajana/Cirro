{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cirro",
  "version": "1.0.0",
  "identifier": "com.drivedeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cirro",
        "width": 1440,
        "height": 850,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://*.googleusercontent.com; font-src 'self' blob: data:; connect-src 'self' blob: ipc: http://ipc.localhost; media-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "flow-engine/*"
    ],
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Your Google Drive workspace",
    "longDescription": "Manage Google Drive accounts, browse files, and sync your folders with Cirro.",
    "publisher": "Cirro",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Cirro",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
