{
  "name": "cirro",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "eslint src && tsc --noEmit",
    "test:release": "vitest run --exclude tests/auth.test.tsx --exclude tests/files.test.tsx && node --test scripts/version.test.mjs scripts/release-notes.test.mjs",
    "postinstall": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/bump-version.mjs --check && node scripts/prepare-assets.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "dev:android": "vite --host 0.0.0.0 --port 1421 --open /android",
    "preview:android": "vite preview --host 0.0.0.0 --port 1421 --open /android",
    "build:android": "tsc --noEmit && vite build --config vite.android.config.ts",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:apk": "npm run android:sync && node scripts/android-gradle.mjs assembleDebug",
    "android:release:apk": "npm run android:sync && node scripts/android-gradle.mjs assembleRelease",
    "android:signing-report": "node scripts/android-gradle.mjs signingReport",
    "android:share": "node scripts/serve-android-apk.mjs",
    "android:live:apk": "node scripts/android-live.mjs build",
    "android:live:install": "node scripts/android-live.mjs install",
    "android:live": "node scripts/android-live.mjs start",
    "prebuild:android": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capgo/capacitor-social-login": "^8.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.15",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
